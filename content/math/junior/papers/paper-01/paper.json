              "id": "A",
              "text": "−3"
            },
            {
              "id": "B",
              "text": "−4"
            },
            {
              "id": "C",
              "text": "−5"
            },
            {
              "id": "D",
              "text": "0"
            }
          ],
          "answer": "C",
          "solution": "−5 在数轴上比 −4 更靠左，故 −5 < −4。",
          "topic": "directed-numbers",
          "levelTag": "S1",
          "assetIds": [],
          "imagePlacement": null

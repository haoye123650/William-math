    {
      "id": "notes",
      "kind": "passage",
      "title": "Key Ideas",
      "paragraphs": [
        {
          "id": "p1",
          "html": "<p><strong>正整数指数</strong>：aⁿ = a×a×…×a（n 个）。a¹=a。</p>"
        },
        {
          "id": "p2",
          "html": "<p><strong>零指数</strong>：a⁰ = 1（a≠0）。</p>"
        },
        {
          "id": "p3",
          "html": "<p><strong>乘除律</strong>：aᵐ × aⁿ = aᵐ⁺ⁿ；aᵐ ÷ aⁿ = aᵐ⁻ⁿ（a≠0）。</p>"
        },
        {
          "id": "p4",
          "html": "<p><strong>乘方</strong>：(aᵐ)ⁿ = aᵐⁿ；(ab)ⁿ = aⁿbⁿ；(a/b)ⁿ = aⁿ/bⁿ。</p>"
        },
        {
          "id": "p5",
          "html": "<p><strong>负指数</strong>：a⁻ⁿ = 1/aⁿ（a≠0）。例：2⁻³=1/8。</p>"
        }
      ]
    },

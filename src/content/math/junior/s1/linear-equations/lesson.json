      "items": [
        {
          "id": "c1",
          "interaction": "short-text",
          "prompt": "[S3] Solve for x: |2x − 5| = 9. Give both solutions, smaller first, separated by a comma.",
          "answer": "-2,7",
          "solution": "2x−5=9 或 2x−5=−9 → 2x=14 或 2x=−4 → x=7 或 x=−2。",
          "level": "challenge"
        },

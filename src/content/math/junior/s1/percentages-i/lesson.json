  "titleEn": "Percentages (I)",
  "titleZh": "百分法（一）",
  "edbUnit": "百分法",
  "difficulty": {
    "core": "S1-S2",
    "stretch": "S3",
    "mixNote": "约30%S1 + 40%S2 + 30%S3"
  },
  "objectives": [
    "在百分数、小数、分数之间互化（S1）",
    "求一个量的百分之几；已知部分求整体（S1–S2）",
    "百分率增减、折扣与简单盈亏（S2）",
    "连续百分变化、逆向还原（S2–S3）"
  ],
  "blocks": [
    {
      "id": "warmup",
      "kind": "exercise",
      "title": "Warm-up",
      "items": [
        {
          "id": "w1",
          "interaction": "fill-blank",
          "prompt": "[S1] Convert 0.35 to a percentage: ____%",
          "answer": "35",
          "solution": "0.35=35/100=35%。",
          "level": "warmup"
        },
        {
          "id": "w2",
          "interaction": "fill-blank",
          "prompt": "[S1] Convert 3/5 to a percentage: ____%",
          "answer": "60",
          "solution": "3/5=0.6=60%。",
          "level": "warmup"
        },
        {
          "id": "w3",
          "interaction": "multiple-choice",
          "prompt": "[S1] What is 20% of 150?",
          "choices": [
            {
              "id": "A",
              "text": "20"
            },
            {
              "id": "B",
              "text": "30"
            },
            {
              "id": "C",
              "text": "50"
            },
            {
              "id": "D",
              "text": "75"
            }
          ],
          "answer": "B",
          "solution": "0.2×150=30。",
          "level": "warmup"
        },
        {
          "id": "w4",
          "interaction": "true-false",
          "prompt": "[S1] True or False: 1/4 = 25%.",
          "answer": true,
          "solution": "1/4=0.25=25%。",
          "level": "warmup"
        }
      ]
    },
    {
      "id": "notes",
      "kind": "passage",
      "title": "Key Ideas",
      "paragraphs": [
        {
          "id": "p1",
          "html": "<p><strong>百分数</strong>：分母为 100 的分数。a% = a/100。互化：百分数 ↔ 小数 ↔ 分数。</p>"
        },
        {
          "id": "p2",
          "html": "<p><strong>求百分之几</strong>：p% of N = (p/100)×N。</p>"
        },
        {
          "id": "p3",
          "html": "<p><strong>已知部分求整体</strong>：若 M 是 N 的 p%，则 N = M ÷ (p/100) = M × 100/p。</p>"
        },
        {
          "id": "p4",
          "html": "<p><strong>增减</strong>：增加 r% → 新值 = 原值 × (1+r/100)；减少 r% → 原值 × (1−r/100)。</p>"
        },
        {
          "id": "p5",
          "html": "<p><strong>连续变化</strong>：先后乘各个因子，一般不可把百分率直接相加（S2–S3）。</p>"
        }
      ]
    },
    {
      "id": "practice-l1",
      "kind": "exercise",
      "title": "Level 1",
      "items": [
        {
          "id": "l1-1",
          "interaction": "fill-blank",
          "prompt": "[S1] Find 15% of 80. Answer: ____",

      "items": [
        {
          "id": "c1",
          "interaction": "fill-blank",
          "prompt": "[S3] A price rises by r% then falls by r%, ending at $9600 from $10000. Find r.  r = ____",
          "answer": "20",
          "solution": "10000(1−(r/100)²)=9600 → 1−(r/100)²=0.96 → (r/100)²=0.04 → r/100=0.2 → r=20。",
          "level": "challenge"
        },
        {
          "id": "c2",
          "interaction": "short-text",
          "prompt": "[S3] Mixture: 40 L of 20% salt solution. How many litres of pure water to add to make it 16% salt? ____ L",
          "answer": "10",
          "solution": "盐量不变 40×0.2=8。8/(40+x)=0.16 → 8=6.4+0.16x → 1.6=0.16x → x=10。",
          "level": "challenge"
        },
        {

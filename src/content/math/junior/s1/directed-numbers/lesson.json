        {
          "id": "c2",
          "interaction": "short-text",
          "prompt": "[S3] The temperature at midnight is −8°C. It rises by 3°C each hour until 4 a.m., then falls by 2°C each hour until 7 a.m. What is the temperature at 7 a.m.?",
          "answer": "-2",
          "solution": "0–4 时升 4×3=12 → −8+12=4°C；4–7 时降 3×2=6 → 4−6=−2°C。",
          "level": "challenge"
        },
        {
          "id": "c3",
          "interaction": "fill-blank",
          "prompt": "[S3] If |x − 3| = 7 and x is a directed number less than 0, then x = ____",
          "answer": "-4",
          "solution": "x−3=7 或 x−3=−7 → x=10 或 x=−4；取负数 x=−4。",
          "level": "challenge"
        }
      ]
